{
  "name": "workledger-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:postgres": "node --test tests/postgres.integration.test.cjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:jest": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:all": "npm test && npm run test:jest",
    "test:integration": "jest --config jest.config.cjs --runInBand tests/integration tests/auth/session-timeout.test.ts",
    "test:db": "jest --config jest.config.cjs --runInBand tests/integration tests/auth/session-timeout.test.ts",
    "test:ci": "npm run test && npm run typecheck && npm run build && npm run test:jest",
    "db:reset:test": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.2",
    "jest": "^25.1.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": "true"
}
